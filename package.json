{
  "name": "web-alchemist",
  "version": "0.1.0",
  "description": "Firefox extension that generates and persists per-site CSS/JS transforms from plain-language descriptions",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:firefox": "web-ext run --source-dir ./dist --target firefox-desktop --firefox ./scripts/firefox-flatpak --firefox-profile ./.web-ext-profile --profile-create-if-missing --keep-profile-changes",
    "lint:ext": "web-ext lint --source-dir ./dist",
    "package": "node scripts/package.mjs",
    "check:icons": "node scripts/check-manifest-icons.mjs dist",
    "verify:csp": "VITE_CSP_PROBE=1 vite build && node test/csp/server.mjs",
    "start:firefox:probe": "VITE_CSP_PROBE=1 vite build && web-ext run --source-dir ./dist --target firefox-desktop --firefox ./scripts/firefox-flatpak --firefox-profile ./.web-ext-profile --profile-create-if-missing --keep-profile-changes",
    "verify": "node test/run-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "acorn": "^8.19.0",
    "js-beautify": "2.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-web-extension": "^4.4.3",
    "vitest": "^3.2.4",
    "web-ext": "^10.8.0"
  }
}
