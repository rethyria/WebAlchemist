{
  "name": "web-alchemist",
  "version": "0.1.0",
  "description": "Firefox extension that generates and persists per-site CSS/JS transforms from plain-language descriptions",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:firefox": "web-ext run --source-dir ./dist --target firefox-desktop --firefox ./scripts/firefox-flatpak --firefox-profile ./.web-ext-profile --profile-create-if-missing --keep-profile-changes",
    "lint:ext": "web-ext lint --source-dir ./dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/firefox-webext-browser": "^120.0.4",
    "svelte": "^5.44.0",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-web-extension": "^4.4.3",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0"
  }
}
