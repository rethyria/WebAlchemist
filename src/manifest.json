{
  "manifest_version": 3,
  "name": "Web Alchemist",
  "version": "0.1.0",
  "description": "Describe a change to any webpage and have it written, saved, and repaired when the site changes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@webalchemist",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webNavigation",
    "identity",
    "alarms"
  ],
  "optional_permissions": [
    "userScripts",
    "cookies"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background/index.ts"
    ],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "Web Alchemist",
    "default_panel": "src/sidebar/index.html",
    "default_icon": {
      "16": "icons/sidebar-16.png",
      "32": "icons/sidebar-32.png"
    }
  },
  "action": {
    "default_title": "Web Alchemist",
    "default_icon": {
      "16": "icons/toolbar-on-light-16.png",
      "32": "icons/toolbar-on-light-32.png"
    },
    "theme_icons": [
      {
        "light": "icons/toolbar-on-dark-16.png",
        "dark": "icons/toolbar-on-light-16.png",
        "size": 16
      },
      {
        "light": "icons/toolbar-on-dark-32.png",
        "dark": "icons/toolbar-on-light-32.png",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
